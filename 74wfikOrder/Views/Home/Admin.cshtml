@{
    ViewData["Title"] = "Espace Admin";
}

<section class="admin-hero page-card p-5 mb-4">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge rounded-pill text-bg-warning mb-3 px-3 py-2">
                Espace Administrateur
            </span>

            <h1 class="fw-bold display-5">
                Gestion du restaurant
            </h1>

            <p class="lead text-muted">
                Gérez les catégories, les articles et suivez les commandes depuis un espace simple et professionnel.
            </p>
        </div>

        <div class="col-lg-4 text-lg-end">
            <img src="https://cdn-icons-png.flaticon.com/512/3188/3188219.png"
                 alt="KAYU SUSHI"
                 style="max-width: 170px;" />
        </div>
    </div>
</section>

<div class="row g-4">
    <div class="col-md-4">
        <div class="page-card p-4 h-100">
            <h3 class="fw-bold">Catégories</h3>
            <p class="text-muted">
                Organiser les familles d’articles du restaurant avec ADO.NET.
            </p>
            <a asp-controller="Categories" asp-action="Index" class="btn btn-primary">
                Gérer les catégories
            </a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="page-card p-4 h-100">
            <h3 class="fw-bold">Articles</h3>
            <p class="text-muted">
                Ajouter, modifier et supprimer les plats du menu avec Entity Framework.
            </p>
            <a asp-controller="Articles" asp-action="Index" class="btn btn-success">
                Gérer les articles
            </a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="page-card p-4 h-100">
            <h3 class="fw-bold">Commandes</h3>
            <p class="text-muted">
                Consulter les commandes passées par les clients.
            </p>
            <a asp-controller="Commandes" asp-action="Index" class="btn btn-outline-secondary">
                Voir les commandes
            </a>
        </div>
    </div>
</div>
