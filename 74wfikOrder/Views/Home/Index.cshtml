@{
    ViewData["Title"] = "Accueil - KayuSushi";
}

<div class="hero-container py-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <div class="glass-panel p-5 animate-fade-in">
                <span class="badge bg-primary px-3 py-2 rounded-pill mb-3 shadow-sm">L'EXCELLENCE CULINAIRE JAPONAISE</span>
                <div class="position-absolute top-0 end-0 opacity-10 user-select-none" style="font-size: 200px; font-family: 'Noto Serif JP', serif; z-index: -1; right: -50px; top: -50px; color: var(--primary);">
                    寿司
                </div>
                <h1 class="display-3 fw-black mb-4">Savourez le meilleur du <span class="text-primary">Japon</span></h1>
                <p class="lead text-muted mb-5 fs-4">
                    Une expérience gastronomique unique combinant tradition japonaise et modernité digitale. Commandez vos sushis préférés en un clic.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-controller="Menu" asp-action="Index" class="btn btn-primary btn-lg px-5 py-3 shadow-lg">
                        <i class="bi bi-shop me-2"></i>Explorer le Menu
                    </a>
                    @if (Context.Session.GetString("UserRole") == "Admin")
                    {
                        <a asp-controller="Home" asp-action="Admin" class="btn btn-outline-primary btn-lg px-4 py-3">
                            <i class="bi bi-shield-check me-2"></i>Dashboard
                        </a>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="position-relative">
                <div class="hero-image-wrapper glass-panel p-2 rotate-3 animate-float">
                    <img src="https://images.unsplash.com/photo-1579871494447-9811cf80d66c?q=80&w=2070&auto=format&fit=crop" 
                         alt="Sushi Premium" 
                         class="img-fluid rounded-4 shadow-2xl" 
                         style="min-height: 400px; object-fit: cover; width: 100%;" />
                </div>
                <!-- Abstract blobs for depth -->
                <div class="blob-1 position-absolute top-0 start-0 translate-middle bg-primary opacity-20 blur-3xl rounded-circle" style="width: 300px; height: 300px; z-index: -1;"></div>
                <div class="blob-2 position-absolute bottom-0 end-0 translate-middle bg-danger opacity-20 blur-3xl rounded-circle" style="width: 250px; height: 250px; z-index: -1;"></div>
            </div>
        </div>
    </div>

    <div class="row mt-5 pt-5 g-4">
        <div class="col-md-4">
            <div class="glass-panel p-4 h-100 text-center hover-up">
                <div class="bg-primary bg-opacity-10 rounded-circle p-3 d-inline-block mb-3">
                    <i class="bi bi-lightning-charge-fill text-primary fs-2"></i>
                </div>
                <h4>Vitesse Ninja</h4>
                <p class="text-muted">Commandez et soyez livré avec la vélocité d'un shinobi grâce à notre logistique optimisée.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-panel p-4 h-100 text-center hover-up">
                <div class="bg-success bg-opacity-10 rounded-circle p-3 d-inline-block mb-3">
                    <i class="bi bi-map-fill text-success fs-2"></i>
                </div>
                <h4>Suivi Live</h4>
                <p class="text-muted">Suivez votre livreur en temps réel avec notre carte interactive, telle la vision de l'aigle.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-panel p-4 h-100 text-center hover-up">
                <div class="bg-info bg-opacity-10 rounded-circle p-3 d-inline-block mb-3">
                    <i class="bi bi-shield-fill-check text-info fs-2"></i>
                </div>
                <h4>Qualité Shokunin</h4>
                <p class="text-muted">Nos maîtres sushis préparent chaque commande avec la plus grande précision artisanale.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-black { font-weight: 900; }
    .rotate-3 { transform: rotate(3deg); }
    .shadow-2xl { box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); }
    .blur-3xl { filter: blur(64px); }
    
    .animate-fade-in {
        animation: fadeIn 1s ease-out forwards;
    }
    
    .animate-float {
        animation: float 6s ease-in-out infinite;
    }
    
    .hover-up {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .hover-up:hover {
        transform: translateY(-10px);
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateX(-30px); }
        to { opacity: 1; transform: translateX(0); }
    }
    
    @@keyframes float {
        0%, 100% { transform: translateY(0) rotate(3deg); }
        50% { transform: translateY(-20px) rotate(5deg); }
    }
</style>
