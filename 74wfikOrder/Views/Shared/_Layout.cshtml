@{
    var userRole = Context.Session.GetString("UserRole");
    var userName = Context.Session.GetString("UserName");
    var isConnected = !string.IsNullOrEmpty(userRole);
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KAYU SUSHI</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;700&family=Outfit:wght@300;400;500;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header class="glass-navbar">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand brand-block" asp-controller="Home" asp-action="Index">
                    <img src="https://cdn-icons-png.flaticon.com/512/3188/3188219.png" alt="KAYU SUSHI" class="brand-logo" />
                    <span>KAYU SUSHI</span>
                </a>

                <button class="navbar-toggler custom-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        
                        <!-- Theme Toggle Button -->
                        <li class="nav-item me-lg-2">
                            <button id="themeToggleBtn" class="theme-toggle" aria-label="Toggle Dark Mode">
                                <i class="bi bi-moon-stars" id="themeIcon"></i>
                            </button>
                        </li>

                        @if (!isConnected)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-pill" asp-controller="Account" asp-action="Login">
                                    Connexion
                                </a>
                            </li>
                        }

                        @if (userRole == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-pill" asp-controller="Home" asp-action="Admin">
                                    <i class="bi bi-shield-lock-fill"></i> Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link nav-pill" asp-controller="Categories" asp-action="Index">
                                    Catégories
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link nav-pill" asp-controller="Articles" asp-action="Index">
                                    Articles
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link nav-pill" asp-controller="Commandes" asp-action="Index">
                                    Commandes
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                <a class="nav-link nav-pill" asp-controller="Stock" asp-action="Index">
                                    Stocks
                                </a>
                            </li>
                        }

                        @if (userRole == "Client")
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-pill" asp-controller="Menu" asp-action="Index">
                                    Menu
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link nav-pill" asp-controller="Panier" asp-action="Index">
                                    Panier
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link nav-pill" asp-controller="Commandes" asp-action="MesCommandes">
                                    Mes commandes
                                </a>
                            </li>
                        }

                        @if (isConnected)
                        {
                            <li class="nav-item ms-lg-2">
                                <span class="user-badge">
                                    <i class="bi bi-person-circle me-1"></i> @userName
                                </span>
                            </li>

                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-outline-danger rounded-pill fw-bold btn-sm py-2 px-3" asp-controller="Account" asp-action="Logout">
                                    Déconnexion
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="app-main pt-5">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer mt-5" style="background: var(--glass-bg); backdrop-filter: blur(12px);">
        <div class="container py-3 d-flex justify-content-center gap-2 align-items-center flex-wrap">
            <span class="text-muted fw-bold">© 2026 - KAYU SUSHI</span>
            <span class="footer-dot text-primary fw-bold">•</span>
            <span class="text-muted">L'excellence de la gastronomie japonaise</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
