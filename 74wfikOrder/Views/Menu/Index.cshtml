@model IEnumerable<KayuSushi.Models.Article>

@{
    ViewData["Title"] = "Menu du restaurant";

    var categories = ViewBag.AllCategories as List<string> ?? new List<string>();
}

<link rel="stylesheet" href="~/css/menu.css" />

<div class="menu-page">

    <section class="menu-hero">
        <div class="menu-hero-overlay">
            <span class="menu-badge">KAYU SUSHI</span>

            <h1>
                <span style="font-family: 'Noto Serif JP', serif; font-size: 0.6em; display: block; color: var(--primary); opacity: 0.9; margin-bottom: 5px;">メニュー</span>
                Menu du restaurant
            </h1>

            <p>
                Découvrez notre sélection japonaise : sushis, makis, sashimis,
                california rolls, spring rolls, boissons et desserts.
            </p>

            <div class="hero-actions">
                <a href="#menu-list" class="hero-btn-primary">
                    Voir le menu
                </a>

                <a asp-controller="Panier" asp-action="Index" class="hero-btn-secondary">
                    Voir le panier
                </a>
            </div>
        </div>
    </section>

    <section class="menu-section" id="menu-list">
        <div class="section-title">
            <div>
                <span class="section-kicker">Notre sélection</span>
                <h2>Nos plats disponibles</h2>
                <p>
                    Choisissez votre repas et ajoutez-le directement au panier.
                </p>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-menu">
                <h3>Aucun article disponible</h3>
                <p>Ajoutez des articles depuis l’espace administrateur.</p>
            </div>
        }
        else
        {
            <div class="category-filter">
                <button type="button" class="filter-chip active" data-filter="all">
                    Tous
                </button>

                @foreach (var categorie in categories)
                {
                    <button type="button" class="filter-chip" data-filter="@categorie">
                        @categorie
                    </button>
                }
            </div>

            <div class="menu-grid">
                @foreach (var item in Model)
                {
                    var categorie = item.Categorie?.NomCategorie ?? "Sans catégorie";

                    <div class="menu-card" data-category="@categorie">
                        <div class="menu-image-wrapper">
                            <img src="@item.ImageUrl"
                                 alt="@item.NomArticle"
                                 class="menu-image"
                                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1579871494447-9811cf80d66c?q=80&w=600&auto=format&fit=crop';" />

                            @if (item.Disponible)
                            {
                                <span class="status-badge available">
                                    Disponible
                                </span>
                            }
                            else
                            {
                                <span class="status-badge unavailable">
                                    Indisponible
                                </span>
                            }
                        </div>

                        <div class="menu-card-body">
                            <div class="category-line">
                                @categorie
                            </div>

                            <h3>@item.NomArticle</h3>

                            <p class="description">
                                @item.Description
                            </p>

                            <div class="price-row">
                                <span>Prix</span>
                                <strong>@item.Prix.ToString("0.000") DT</strong>
                            </div>

                            <div class="menu-actions">
                                <a asp-controller="Menu"
                                   asp-action="Details"
                                   asp-route-id="@item.IdArticle"
                                   class="btn-details">
                                    Détails
                                </a>

                                @if (item.Disponible)
                                {
                                    <a asp-controller="Panier"
                                       asp-action="Ajouter"
                                       asp-route-id="@item.IdArticle"
                                       class="btn-cart">
                                        Ajouter au panier
                                    </a>
                                }
                                else
                                {
                                    <button type="button" class="btn-disabled" disabled>
                                        Indisponible
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const chips = document.querySelectorAll(".filter-chip");
            const cards = document.querySelectorAll(".menu-card");

            chips.forEach(chip => {
                chip.addEventListener("click", function () {
                    const filter = this.getAttribute("data-filter");

                    chips.forEach(c => c.classList.remove("active"));
                    this.classList.add("active");

                    cards.forEach(card => {
                        const category = card.getAttribute("data-category");

                        if (filter === "all" || category === filter) {
                            card.style.display = "block";
                        } else {
                            card.style.display = "none";
                        }
                    });
                });
            });
        });
    </script>
}
