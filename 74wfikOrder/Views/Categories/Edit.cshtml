@model KayuSushi.Models.Categorie

@{
    ViewData["Title"] = "Modifier une cat�gorie";
}

<h1>Modifier une cat�gorie</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="IdCategorie" />

    <div class="form-group mb-3">
        <label asp-for="NomCategorie" class="control-label"></label>
        <input asp-for="NomCategorie" class="form-control" />
