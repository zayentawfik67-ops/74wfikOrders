@model KayuSushi.Models.Commande

@{
    ViewData["Title"] = "Suivi de Commande";
    
    // Default to Sfax center if coordinates not available
    var destLat = Model.DeliveryLatitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "34.74056";
    var destLng = Model.DeliveryLongitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "10.76028";
    
    // Mock restaurant location
    var resLat = "34.73500";
    var resLng = "10.75500";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Suivi de la Commande #@Model.IdCommande</h2>
            <span class="badge bg-primary px-3 py-2 fs-6">@Model.Statut</span>
        </div>
        <div>
            <a asp-action="Details" asp-route-id="@Model.IdCommande" class="btn btn-outline-secondary">
                Retour aux détails
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="height: 500px;">
                <div id="deliveryMap" style="width: 100%; height: 100%;"></div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="fw-bold mb-4">Détails de Livraison</h5>
                    
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-light rounded-circle p-3 me-3 text-primary">
                            <i class="bi bi-clock-history fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Temps estimé</small>
                            <h4 class="fw-bold mb-0" id="estimatedTime">-- min</h4>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-light rounded-circle p-3 me-3 text-success">
                            <i class="bi bi-geo-alt fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Distance restante</small>
                            <h4 class="fw-bold mb-0" id="remainingDistance">-- km</h4>
                        </div>
                    </div>

                    <hr class="my-4" />
                    
                    <div class="mb-3">
                        <h6 class="fw-bold">Adresse Client :</h6>
                        <p class="text-muted mb-0">@Model.AdresseLivraison, @Model.VilleLivraison</p>
                        <p class="text-muted">@Model.TelephoneLivraison</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Leaflet CSS & JS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var destLat = parseFloat('@destLat');
            var destLng = parseFloat('@destLng');
            var resLat = parseFloat('@resLat');
            var resLng = parseFloat('@resLng');

            // Initialize map
            var map = L.map('deliveryMap').setView([resLat, resLng], 14);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            // Icons
            var restaurantIcon = L.icon({
                iconUrl: 'https://cdn-icons-png.flaticon.com/512/3188/3188219.png',
                iconSize: [40, 40],
                iconAnchor: [20, 40],
                popupAnchor: [0, -40]
            });

            var customerIcon = L.icon({
                iconUrl: 'https://cdn-icons-png.flaticon.com/512/3180/3180182.png',
                iconSize: [40, 40],
                iconAnchor: [20, 40],
                popupAnchor: [0, -40]
            });
            
            var driverIcon = L.icon({
                iconUrl: 'https://cdn-icons-png.flaticon.com/512/3063/3063822.png',
                iconSize: [45, 45],
                iconAnchor: [22, 45],
                popupAnchor: [0, -45]
            });

            // Markers
            var restaurantMarker = L.marker([resLat, resLng], {icon: restaurantIcon}).addTo(map)
                .bindPopup('<b>KAYU SUSHI</b><br>Restaurant Japonais').openPopup();
                
            var customerMarker = L.marker([destLat, destLng], {icon: customerIcon}).addTo(map)
                .bindPopup('<b>Destination</b><br>@Model.AdresseLivraison');

            var driverMarker = L.marker([resLat, resLng], {icon: driverIcon}).addTo(map);

            // Simple Distance calculation (Haversine formula approximation)
            function getDistance(lat1, lon1, lat2, lon2) {
                var R = 6371; // Radius of the earth in km
                var dLat = (lat2 - lat1) * Math.PI / 180;  
                var dLon = (lon2 - lon1) * Math.PI / 180; 
                var a = 
                    0.5 - Math.cos(dLat)/2 + 
                    Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * 
                    (1 - Math.cos(dLon))/2;
                return R * 2 * Math.asin(Math.sqrt(a));
            }

            var totalDist = getDistance(resLat, resLng, destLat, destLng);
            document.getElementById('remainingDistance').innerText = totalDist.toFixed(2) + ' km';
            document.getElementById('estimatedTime').innerText = Math.round(totalDist * 12) + ' min'; // Assume 12 mins per km approx city traffic

            // Simulate Driver Movement along a straight line for demo purposes
            var steps = 100;
            var currentStep = 0;
            var latStep = (destLat - resLat) / steps;
            var lngStep = (destLng - resLng) / steps;

            var simInterval = setInterval(function() {
                if(currentStep >= steps) {
                    clearInterval(simInterval);
                    document.getElementById('remainingDistance').innerText = '0.00 km';
                    document.getElementById('estimatedTime').innerText = 'Arrivé';
                    driverMarker.bindPopup('<b>Livreur Arrivé!</b>').openPopup();
                    return;
                }

                var newLat = resLat + (latStep * currentStep);
                var newLng = resLng + (lngStep * currentStep);
                driverMarker.setLatLng([newLat, newLng]);
                
                var remDist = getDistance(newLat, newLng, destLat, destLng);
                document.getElementById('remainingDistance').innerText = remDist.toFixed(2) + ' km';
                document.getElementById('estimatedTime').innerText = Math.max(1, Math.round(remDist * 12)) + ' min';
                
                currentStep++;
            }, 500); // update every 500ms

            // Fit bounds
            var group = new L.featureGroup([restaurantMarker, customerMarker]);
            map.fitBounds(group.getBounds().pad(0.2));
        });
    </script>
}
