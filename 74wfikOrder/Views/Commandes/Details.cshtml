@model KayuSushi.Models.Commande

@{
    ViewData["Title"] = "Détails commande";
}

<div class="page-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Commande #@Model.IdCommande</h1>
            <p class="text-muted mb-0">
                Passée le @Model.DateCommande.ToString("dd/MM/yyyy à HH:mm")
            </p>
        </div>

        <span class="badge bg-warning text-dark fs-6 px-3 py-2">
            @Model.Statut
        </span>
    </div>

    <div class="row g-4 print-receipt">
        <div class="col-lg-8">
            @foreach (var ligne in Model.LignesCommande)
            {
                <div class="card mb-3 shadow-sm border-0">
                    <div class="row g-0">
                        <div class="col-md-4">
                            <img src="@ligne.Article?.ImageUrl"
                                 class="img-fluid rounded-start h-100"
                                 style="object-fit: cover; min-height: 170px;"
                                 alt="@ligne.Article?.NomArticle"
                                 onerror="this.onerror=null;this.src='/images/hero/hero-tunisian-fastfood-spread.png';" />
                        </div>

                        <div class="col-md-8">
                            <div class="card-body">
                                <span class="badge bg-light text-dark mb-2">
                                    @ligne.Article?.Categorie?.NomCategorie
                                </span>

                                <h4 class="fw-bold">
                                    @ligne.Article?.NomArticle
                                </h4>

                                <p class="text-muted">
                                    @ligne.Article?.Description
                                </p>

                                <div class="d-flex justify-content-between">
                                    <span>Quantité : <strong>@ligne.Quantite</strong></span>
                                    <span>Prix : <strong>@ligne.PrixUnitaire.ToString("0.000") DT</strong></span>
                                    <span class="text-success">
                                        Sous-total :
                                        <strong>@ligne.SousTotal.ToString("0.000") DT</strong>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card shadow border-0 mb-4">
                <div class="card-body">
                    <h5 class="fw-bold mb-3"><i class="bi bi-truck text-primary me-2"></i>Livraison</h5>
                    
                    <div class="mb-2">
                        <small class="text-muted d-block">Adresse</small>
                        <span>@Model.AdresseLivraison, @Model.VilleLivraison</span>
                    </div>
                    
                    <div class="mb-2">
                        <small class="text-muted d-block">Téléphone</small>
                        <span>@Model.TelephoneLivraison</span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Remarques))
                    {
                        <div class="mb-0">
                            <small class="text-muted d-block">Remarques</small>
                            <span>@Model.Remarques</span>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow border-0 sticky-top" style="top: 100px;">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">Résumé</h4>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Nombre d’articles</span>
                        <strong>@Model.LignesCommande.Sum(l => l.Quantite)</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Statut</span>
                        <strong>@Model.Statut</strong>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fs-5">Total</span>
                        <strong class="fs-4 text-success">
                            @Model.Total.ToString("0.000") DT
                        </strong>
                    </div>
                </div>
            </div>
            
            <div class="mt-4 d-grid gap-2 no-print">
                <button onclick="window.print()" class="btn btn-dark">
                    <i class="bi bi-printer"></i> Imprimer le reçu
                </button>
                <a asp-controller="Commandes" asp-action="Tracking" asp-route-id="@Model.IdCommande" class="btn btn-info text-white">
                    Suivre la commande
                </a>
            </div>
        </div>
    </div>
</div>
